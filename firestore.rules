rules_version = '2';

// Referral backend for Afterlife Bureaucracy. See docs/referrals.md for the model.
// Everyone is an anonymous Firebase user; App Check (Play Integrity) is enforced separately.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    // A player's invite code: 8 chars from the unambiguous alphabet (no 0/O, 1/I, L).
    // Created once by its owner, never changed. Readable one at a time (get), never listed,
    // so codes cannot be enumerated.
    match /codes/{code} {
      allow get: if signedIn();
      allow list: if false;
      allow create: if signedIn()
        && code.matches('[A-HJKMNP-Z2-9]{8}')
        && request.resource.data.keys().hasOnly(['uid'])
        && request.resource.data.uid == request.auth.uid;
      allow update, delete: if false;
    }

    // One doc per physical device (hash of ANDROID_ID), create-only and unreadable: a device
    // can be referred once, so uninstall/reinstall/new-account farming pays nothing.
    match /devices/{deviceHash} {
      allow get, list: if false;
      allow create: if signedIn()
        && deviceHash.matches('[0-9a-f]{64}')
        && request.resource.data.keys().hasOnly(['uid', 'at'])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.at == request.time;
      allow update, delete: if false;
    }

    // One doc per invited install, keyed by the invitee's uid.
    match /referrals/{inviteeUid} {
      // Created by the invitee only, unqualified, naming someone else as inviter, and only in
      // the same commit that creates the matching device doc (getAfter sees that doc).
      allow create: if signedIn()
        && request.auth.uid == inviteeUid
        && request.resource.data.keys().hasOnly(['inviterUid', 'deviceHash', 'qualified', 'createdAt'])
        && request.resource.data.inviterUid is string
        && request.resource.data.inviterUid != request.auth.uid
        && request.resource.data.deviceHash is string
        && request.resource.data.qualified == false
        && request.resource.data.createdAt == request.time
        && getAfter(/databases/$(database)/documents/devices/$(request.resource.data.deviceHash)).data.uid == request.auth.uid;

      // The invitee flips qualified false -> true, touching nothing else.
      allow update: if signedIn()
        && request.auth.uid == inviteeUid
        && resource.data.qualified == false
        && request.resource.data.qualified == true
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['qualified']);

      allow delete: if false;
      allow get: if false;

      // The inviter counts their own joins: the query must filter on inviterUid == own uid.
      allow list: if signedIn() && resource.data.inviterUid == request.auth.uid;
    }

    // Event rankings: one doc per player per event run (key like weekly-2026-10-09 or
    // halloween-2026). A player writes only their own score, and it can only go up. Scores are
    // listable so the game can count how many players are above you (rank = that + 1).
    match /eventScores/{key}/entries/{uid} {
      function validScore() {
        return key.matches('[A-Za-z0-9-]{1,40}')
          && request.resource.data.keys().hasOnly(['score', 'at', 'name'])
          && (!('name' in request.resource.data) || (request.resource.data.name is string && request.resource.data.name.size() <= 24))
          && request.resource.data.score is number
          && request.resource.data.score > 0
          && request.resource.data.at == request.time;
      }
      allow get, list: if signedIn();
      allow create: if signedIn() && request.auth.uid == uid && validScore();
      allow update: if signedIn() && request.auth.uid == uid && validScore()
        && request.resource.data.score >= resource.data.score;
      allow delete: if false;
    }

    // Lifetime-souls board: one doc per player. `score` is log10(souls) for ordering,
    // `souls` the exact Decimal string to show. Only the owner writes; the score never drops.
    match /lifetimeScores/{uid} {
      function validEntry() {
        return request.resource.data.keys().hasOnly(['score', 'souls', 'name', 'at'])
          && request.resource.data.score is number
          && request.resource.data.score > 0
          && request.resource.data.score < 100000
          && request.resource.data.souls is string
          && request.resource.data.souls.size() <= 40
          && request.resource.data.name is string
          && request.resource.data.name.size() >= 1
          && request.resource.data.name.size() <= 24
          && request.resource.data.at == request.time;
      }
      allow get, list: if signedIn();
      allow create: if signedIn() && request.auth.uid == uid && validEntry();
      allow update: if signedIn() && request.auth.uid == uid && validEntry()
        && request.resource.data.score >= resource.data.score;
      allow delete: if false;
    }

    // ---- Office Alliance (src/platform/alliance.ts) ----
    // Week = whole weeks since Monday 1970-01-05 00:00 UTC (rolls over Monday 00:00 UTC), the
    // same number the client's allianceWeek() computes.
    function serverWeek() {
      return math.floor((request.time.toMillis() - 345600000) / 604800000);
    }
    function validName(n) {
      return n is string && n.size() >= 1 && n.size() <= 24;
    }
    function memberPath(id, uid) {
      return /databases/$(database)/documents/alliances/$(id)/members/$(uid);
    }
    function playerPath(uid) {
      return /databases/$(database)/documents/players/$(uid);
    }

    // Which alliance a player is in: the "at most one alliance" lock. Only the owner reads or
    // writes it, and only in the same commit that creates or deletes their member doc.
    match /players/{uid} {
      allow get: if signedIn() && request.auth.uid == uid;
      allow list, delete: if false;
      allow create, update: if signedIn() && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['allianceId'])
        && (
          // Joining: not in one before, and the member doc exists after this commit.
          (request.resource.data.allianceId is string
            && (resource == null || resource.data.allianceId == null)
            && existsAfter(memberPath(request.resource.data.allianceId, uid)))
          ||
          // Leaving: the old member doc is gone after this commit.
          (request.resource.data.allianceId == null
            && resource != null && resource.data.allianceId is string
            && !existsAfter(memberPath(resource.data.allianceId, uid)))
        );
    }

    // Code -> alliance id. Read one at a time; never listed, so codes cannot be enumerated.
    match /allianceCodes/{code} {
      allow get: if signedIn();
      allow list, update, delete: if false;
      allow create: if signedIn()
        && code.matches('[A-HJKMNP-Z2-9]{6}')
        && request.resource.data.keys().hasOnly(['id'])
        && request.resource.data.id is string
        // Only while creating that alliance, by its first member.
        && !exists(/databases/$(database)/documents/alliances/$(request.resource.data.id))
        && existsAfter(memberPath(request.resource.data.id, request.auth.uid));
    }

    // alliances/{id}: { name, size, week, weekStamps, rank, lastActive, createdAt }.
    // rank = week * 1000000 + weekStamps, so one descending query lists this week's leaders.
    // The invite code is NOT here (alliances are listable): it lives in secret/code.
    match /alliances/{id} {
      allow get: if signedIn();
      allow list: if signedIn();
      allow delete: if false;

      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['name', 'size', 'week', 'weekStamps', 'rank', 'lastActive', 'createdAt'])
        && validName(request.resource.data.name)
        && request.resource.data.size == 1
        && request.resource.data.week == serverWeek()
        && request.resource.data.weekStamps == 0
        && request.resource.data.rank == request.resource.data.week * 1000000
        && request.resource.data.lastActive == request.time
        && request.resource.data.createdAt == request.time
        && existsAfter(memberPath(id, request.auth.uid));

      function changed() {
        return request.resource.data.diff(resource.data).affectedKeys();
      }
      function isJoin() {
        return changed().hasOnly(['size', 'lastActive'])
          && request.resource.data.size == resource.data.size + 1
          && request.resource.data.size <= 10
          && request.resource.data.lastActive == request.time
          && !exists(memberPath(id, request.auth.uid))
          && existsAfter(memberPath(id, request.auth.uid));
      }
      function isLeave() {
        return changed().hasOnly(['size'])
          && request.resource.data.size == resource.data.size - 1
          && request.resource.data.size >= 0
          && exists(memberPath(id, request.auth.uid))
          && !existsAfter(memberPath(id, request.auth.uid));
      }
      // A contribution adds exactly what the caller's own member doc adds in the same commit;
      // that doc is rate-limited and capped (below), which bounds the alliance total too.
      function isContribution() {
        let week = request.resource.data.week;
        let aBase = resource.data.week == week ? resource.data.weekStamps : 0;
        let before = get(memberPath(id, request.auth.uid)).data;
        let after = getAfter(memberPath(id, request.auth.uid)).data;
        let mBase = before.week == week ? before.stamps : 0;
        return changed().hasOnly(['week', 'weekStamps', 'rank', 'lastActive'])
          && week == serverWeek()
          && request.resource.data.weekStamps is int
          && request.resource.data.weekStamps - aBase > 0
          && request.resource.data.weekStamps - aBase <= 300
          && request.resource.data.rank == week * 1000000 + request.resource.data.weekStamps
          && request.resource.data.lastActive == request.time
          && after.at == request.time
          && after.week == week
          && after.stamps - mBase == request.resource.data.weekStamps - aBase;
      }
      allow update: if signedIn() && (isJoin() || isLeave() || isContribution());

      // The invite code; members only.
      match /secret/{doc} {
        allow get: if signedIn() && exists(memberPath(id, request.auth.uid));
        allow list, update, delete: if false;
        allow create: if signedIn() && doc == 'code'
          && request.resource.data.keys().hasOnly(['code'])
          && request.resource.data.code is string
          && !exists(/databases/$(database)/documents/alliances/$(id))
          && existsAfter(memberPath(id, request.auth.uid))
          && getAfter(/databases/$(database)/documents/allianceCodes/$(request.resource.data.code)).data.id == id;
      }

      // members/{uid}: { name, week, stamps, at }. Each player writes only their own.
      match /members/{uid} {
        allow get, list: if signedIn();

        // Only in a commit that adds one to size (a join) or creates the alliance at size 1.
        allow create: if signedIn() && request.auth.uid == uid
          && request.resource.data.keys().hasOnly(['name', 'week', 'stamps', 'at'])
          && validName(request.resource.data.name)
          && request.resource.data.week == serverWeek()
          && request.resource.data.stamps == 0
          && request.resource.data.at == request.time
          && getAfter(/databases/$(database)/documents/alliances/$(id)).data.size
             == (exists(/databases/$(database)/documents/alliances/$(id)) ? get(/databases/$(database)/documents/alliances/$(id)).data.size : 0) + 1
          && getAfter(playerPath(uid)).data.allianceId == id;

        // A contribution: at most 300 stamps per write, at most one write per 20 s, at most
        // 10000 stamps per member per week, and only alongside the alliance's own update.
        allow update: if signedIn() && request.auth.uid == uid
          && request.resource.data.keys().hasOnly(['name', 'week', 'stamps', 'at'])
          && validName(request.resource.data.name)
          && request.resource.data.week == serverWeek()
          && request.resource.data.at == request.time
          && request.time > resource.data.at + duration.value(20, 's')
          && request.resource.data.stamps is int
          && request.resource.data.stamps <= 10000
          && request.resource.data.stamps - (resource.data.week == request.resource.data.week ? resource.data.stamps : 0) > 0
          && request.resource.data.stamps - (resource.data.week == request.resource.data.week ? resource.data.stamps : 0) <= 300
          && getAfter(/databases/$(database)/documents/alliances/$(id)).data.lastActive == request.time;

        // Leaving: in the commit that takes one off size and clears the player's lock.
        allow delete: if signedIn() && request.auth.uid == uid
          && getAfter(/databases/$(database)/documents/alliances/$(id)).data.size == get(/databases/$(database)/documents/alliances/$(id)).data.size - 1
          && getAfter(playerPath(uid)).data.allianceId == null;
      }
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
