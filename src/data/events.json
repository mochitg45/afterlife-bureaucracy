{
  "weekly": {
    "currency": "Overflow Drops",
    "deptName": "Overflow Department",
    "accent": "#3B5B8C",
    "themes": [
      {
        "id": "great-backlog",
        "name": "The Great Backlog",
        "blurb": "A filing cabinet in Limbo burst. 40,000 souls are loose in the hallway.",
        "staff": [
          {
            "name": "Soul Wrangler",
            "role": "Hallway recovery",
            "flavor": "Lassoes loose souls with a rope of red tape. Yee-haw, in triplicate.",
            "character": "wk-great-backlog-1"
          },
          {
            "name": "Cabinet Mimic",
            "role": "Reformed filing cabinet",
            "flavor": "Used to eat interns. Now only eats paperwork. Mostly.",
            "character": "wk-great-backlog-2"
          },
          {
            "name": "Hall Monitor Ghost",
            "role": "Corridor patrol",
            "flavor": "Has a whistle, a sash and absolutely no authority.",
            "character": "wk-great-backlog-3"
          }
        ],
        "banner": {
          "name": "The Overdue Throne",
          "featured": "c-wk-great-backlog-x"
        }
      },
      {
        "id": "tax-season",
        "name": "Tax Season in Purgatory",
        "blurb": "Everyone died owing something. Everyone wants a receipt.",
        "staff": [
          {
            "name": "Receipt Goblin",
            "role": "Expense hoarder",
            "flavor": "Keeps every receipt. Every one. Since 1342.",
            "character": "wk-tax-season-1"
          },
          {
            "name": "Abacus Ghost",
            "role": "Old-school accountant",
            "flavor": "Refuses to use a calculator. Faster anyway.",
            "character": "wk-tax-season-2"
          },
          {
            "name": "Deduction Owl",
            "role": "Night auditor",
            "flavor": "Who? Who claimed a horse as a dependant?",
            "character": "wk-tax-season-3"
          }
        ],
        "banner": {
          "name": "Deductible Destiny",
          "featured": "c-wk-tax-season-x"
        }
      },
      {
        "id": "retrograde",
        "name": "Mercury Retrograde Jam",
        "blurb": "The forms are filing themselves backwards. Nobody can explain it.",
        "staff": [
          {
            "name": "Backwards Clerk",
            "role": "Reverse filing",
            "flavor": "Shirt on backwards, walks backwards, files forwards. Usually.",
            "character": "wk-retrograde-1"
          },
          {
            "name": "Astro-Intern",
            "role": "Star chart reader",
            "flavor": "Blames everything on the planets. Is often right.",
            "character": "wk-retrograde-2"
          },
          {
            "name": "Little Mercury",
            "role": "The actual planet",
            "flavor": "Sorry about all this. Brought snacks.",
            "character": "wk-retrograde-3"
          }
        ],
        "banner": {
          "name": "Planetary Misalignment",
          "featured": "c-wk-retrograde-x"
        }
      },
      {
        "id": "lost-socks",
        "name": "Lost Socks Amnesty",
        "blurb": "Every sock ever lost has arrived for processing. With paperwork.",
        "staff": [
          {
            "name": "Sock Puppet Clerk",
            "role": "Odd sock liaison",
            "flavor": "Speaks for socks who cannot speak. Voice is a bit much.",
            "character": "wk-lost-socks-1"
          },
          {
            "name": "Laundry Golem",
            "role": "Basket of everything",
            "flavor": "Made entirely of lost laundry. Smells of fabric softener.",
            "character": "wk-lost-socks-2"
          },
          {
            "name": "Lint Sprite",
            "role": "Dryer-vent spirit",
            "flavor": "Small, fluffy, everywhere. Sneezes are a hazard.",
            "character": "wk-lost-socks-3"
          }
        ],
        "banner": {
          "name": "Pair Amnesty",
          "featured": "c-wk-lost-socks-x"
        }
      },
      {
        "id": "printer-exorcism",
        "name": "The Printer Exorcism",
