        "staff": [
          {
            "name": "Exorcist Intern",
            "role": "Holy toner splasher",
            "flavor": "Armed with a spray bottle of holy water and a can-do attitude.",
            "character": "wk-printer-exorcism-1"
          },
          {
            "name": "Possessed Printer",
            "role": "Reformed demon device",
            "flavor": "PC LOAD LETTER. It knows what it did.",
            "character": "wk-printer-exorcism-2"
          },
          {
            "name": "Paper Jam Poltergeist",
            "role": "Jam specialist",
            "flavor": "Lives inside tray 2. Rattles when it is happy.",
            "character": "wk-printer-exorcism-3"
          }
        ],
        "banner": {
          "name": "Holy Toner",
          "featured": "c-wk-printer-exorcism-x"
        }
      },
      {
        "id": "casual-friday",
        "name": "Casual Friday, Eternally",
        "blurb": "Hawaiian shirts approved for the rest of time. Productivity: unclear.",
        "staff": [
          {
            "name": "Aloha Reaper",
            "role": "Business-casual death",
