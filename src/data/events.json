          },
          {
            "name": "Flip-Flop Angel",
            "role": "Relaxed seraph",
            "flavor": "Halo tilted at a jaunty angle. Wings in sunscreen.",
            "character": "wk-casual-friday-2"
          },
          {
            "name": "Smoothie Demon",
            "role": "Break-room barista",
            "flavor": "Blends anything into a smoothie. Do not ask what is in the green one.",
            "character": "wk-casual-friday-3"
          }
        ],
        "banner": {
          "name": "Dress Code: Eternal",
          "featured": "c-wk-casual-friday-x"
        }
      },
      {
        "id": "valhalla-feast",
        "name": "The Feast of Valhalla",
        "blurb": "Odin double-booked the mead hall. Every fallen warrior needs a seat assignment, in triplicate.",
        "staff": [
          {
            "name": "Valkyrie Usher",
            "role": "Seat assignments",
            "flavor": "Flies every fallen warrior to the right bench. Clipboard is also a shield.",
            "character": "wk-valhalla-feast-1"
          },
          {
            "name": "Mead Hall Steward",
            "role": "Horn-tray server",
            "flavor": "Horned helmet, endless drinking horn, perfect posture.",
            "character": "wk-valhalla-feast-2"
          },
          {
            "name": "Raven Messenger",
            "role": "Odin's mail desk",
            "flavor": "Remembers everything. Will tell everyone.",
            "character": "wk-valhalla-feast-3"
          }
        ],
        "banner": {
          "name": "The Great Hall Ledger",
          "featured": "c-wk-valhalla-feast-x"
        }
      },
      {
        "id": "sin-pride",
        "name": "Pride Before the Fall",
        "blurb": "Every soul insists their file is the most important one. They are all wrong.",
        "staff": [
          {
            "name": "Peacock Clerk",
            "role": "Very important bird",
            "flavor": "Fans its tail at every form. The forms are not impressed.",
            "character": "wk-sin-pride-1"
          },
          {
            "name": "Mirror Imp",
            "role": "Reflection services",
            "flavor": "Carries a hand mirror so souls can admire themselves while queueing.",
            "character": "wk-sin-pride-2"
          },
          {
            "name": "Lion Notary",
            "role": "King of the stamp",
            "flavor": "Wears a tiny crown. Stamps with great dignity.",
            "character": "wk-sin-pride-3"
          }
        ],
        "banner": {
          "name": "Mirror, Mirror",
          "featured": "c-wk-sin-pride-x"
        }
      },
      {
        "id": "sin-greed",
        "name": "The Greed Ledger",
        "blurb": "Souls keep trying to take it with them. Customs is overwhelmed.",
        "staff": [
          {
            "name": "Coin Goblin",
            "role": "Pocket inspector",
            "flavor": "Checks every pocket for coins souls try to sneak through.",
            "character": "wk-sin-greed-1"
          },
          {
            "name": "Piggy Bank Clerk",
            "role": "Deposits only",
            "flavor": "Accepts all coins. Returns none.",
            "character": "wk-sin-greed-2"
          },
          {
            "name": "Treasurer Dragon",
            "role": "Hoard management",
            "flavor": "Sleeps on the confiscated gold. Calls it filing.",
            "character": "wk-sin-greed-3"
          }
